# Voice runtime image — Pipecat pipeline on AWS Bedrock AgentCore Runtime.
#
# A long-running, stateful WebRTC server that AgentCore runs directly.
# It exposes the BedrockAgentCoreApp (/ping + /invocations) on :8080.
#
# Key decisions:
#   - ARM64 base: AgentCore Runtime runs ARM64 containers.
#   - uvicorn --workers 1: peer-connection state is shared in-process and must
#     not be sharded across workers.
#
# Build context is the REPO ROOT (the image needs both runtime/ and resources/);
# the root .dockerignore keeps that context small while the legacy tree coexists.
#
# Local build smoke test (run before every deploy):
#   docker build --platform linux/arm64 -f runtime/Dockerfile.voice -t bridge-voice .
#   docker run --rm -p 8080:8080 bridge-voice   # then: curl localhost:8080/ping
FROM --platform=linux/arm64 python:3.11-slim

# System libs aiortc / onnxruntime / soundfile / opencv need at runtime.
# libGL + libglib are required by opencv (cv2), which pipecat-ai[webrtc] pulls in
# for the SmallWebRTC transport; without them `import cv2` fails on libGL.so.1.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
        libsndfile1 \
        libsrtp2-dev \
        libopus-dev \
        libvpx-dev \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies first for better layer caching.
COPY runtime/requirements-voice.txt ./
RUN pip install --no-cache-dir -r requirements-voice.txt

# The kit package + BRIDGE's own runtime code, plus the scenario/prompt files
# the game engine reads at runtime.
COPY runtime/voice_kit /app/voice_kit
COPY runtime/bridge /app/bridge
COPY resources /app/resources
ENV PYTHONPATH=/app

EXPOSE 8080

# Run the BedrockAgentCoreApp via uvicorn. --workers 1 is mandatory: the voice
# runtime keeps WebRTC peer-connection state AND the in-memory game sessions in
# this process's memory.
#
# bridge.app registers the game engine on the kit's extension points at import
# and re-exports voice_kit.runtime:app — importing it is what wires the referee,
# the clock and the session registry into the pipeline.
CMD ["uvicorn", "bridge.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
