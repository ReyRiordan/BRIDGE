# Voice runtime image — Pipecat pipeline on AWS Bedrock AgentCore Runtime.
#
# A long-running, stateful WebRTC server that AgentCore runs directly.
# It exposes the BedrockAgentCoreApp (/ping + /invocations) on :8080.
#
# Key decisions:
#   - ARM64 base: AgentCore Runtime runs ARM64 containers.
#   - uvicorn --workers 1: peer-connection state is shared in-process and must
#     not be sharded across workers.
#
# Local build smoke test (run before every deploy):
#   docker build --platform linux/arm64 -f Dockerfile.voice -t voice-kit .
#   docker run --rm -p 8080:8080 voice-kit   # then: curl localhost:8080/ping
FROM --platform=linux/arm64 python:3.11-slim

# System libs aiortc / onnxruntime / soundfile / opencv need at runtime.
# libGL + libglib are required by opencv (cv2), which pipecat-ai[webrtc] pulls in
# for the SmallWebRTC transport; without them `import cv2` fails on libGL.so.1.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
        libsndfile1 \
        libsrtp2-dev \
        libopus-dev \
        libvpx-dev \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies first for better layer caching.
COPY requirements-voice.txt ./
RUN pip install --no-cache-dir -r requirements-voice.txt

# The kit package. Add a COPY line for your own wrapper module (the one that
# registers a context provider + transcript handler — see
# docs/01-integration-guide.md), e.g.:
#   COPY my_voice_app.py /app/my_voice_app.py
COPY voice_kit /app/voice_kit
ENV PYTHONPATH=/app

EXPOSE 8080

# Run the BedrockAgentCoreApp via uvicorn. --workers 1 is mandatory: the voice
# runtime keeps WebRTC peer-connection state in this process's memory.
#
# With a host wrapper module, point uvicorn at it instead so your context
# provider/transcript handler are registered at import:
#   CMD ["uvicorn", "my_voice_app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
CMD ["uvicorn", "voice_kit.runtime:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
