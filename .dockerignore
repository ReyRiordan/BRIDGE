# Shared ignore list for the TWO image assets built from the REPO ROOT:
# runtime/Dockerfile.voice (needs runtime/ + resources/) and api/Dockerfile.api
# (needs api/ + resources/ + runtime/voice_kit). This list is what keeps that
# context small while the legacy app and the rewrite coexist; each asset then
# subtracts the OTHER's tree via its CDK `exclude` prop (amplify/constants.ts),
# which is what keeps their hashes independent.
#
# NEVER list a tree an image COPYs. CDK derives the asset hash from the staged
# copy, so an excluded tree freezes the hash and ships stale code with no error.

# Legacy app trees (removed at final teardown)
frontend/
backend/
scenes/
visuals/
app.py
requirements.txt
render.yaml

# New trees neither image needs
web/
docs/
amplify/
scripts/
node_modules/
runtime/tests/

# CDK build output. NOT optional and NOT covered by `amplify/` above: CDK
# stages this docker context (the repo root) INTO .amplify/artifacts/cdk.out/,
# so leaving these in makes staging copy its own output into itself until the
# path blows past the OS limit (ENAMETOOLONG).
.amplify/
cdk.out/
amplify_outputs.json

# VCS / tooling / build junk. These are recursive on purpose: a local
# `pip install ./runtime` regenerates runtime/build/ + runtime/*.egg-info, and
# root-anchored patterns would let that untracked junk bust BOTH asset hashes.
.git/
.github/
.claude/
**/__pycache__/
**/*.pyc
**/tests/
**/.pytest_cache/
**/.ruff_cache/
**/.venv*/
**/*.egg-info/
**/build/
**/dist/
**/coverage/
.env
.DS_Store
