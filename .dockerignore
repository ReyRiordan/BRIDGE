# The voice runtime image builds from the REPO ROOT (see runtime/Dockerfile.voice)
# so it can COPY both runtime/ and resources/. While the legacy app and the
# rewrite coexist, this exclude list is what keeps the build context small —
# effectively only runtime/ and resources/ reach the daemon.

# Legacy app trees (removed at final teardown)
frontend/
backend/
scenes/
visuals/
app.py
requirements.txt
render.yaml

# New trees not needed in the runtime image
web/
docs/
amplify/
api/
scripts/
node_modules/
runtime/tests/

# CDK build output. NOT optional and NOT covered by `amplify/` above: CDK
# stages this docker context (the repo root) INTO .amplify/artifacts/cdk.out/,
# so leaving these in makes staging copy its own output into itself until the
# path blows past the OS limit (ENAMETOOLONG).
.amplify/
cdk.out/
amplify_outputs.json

# VCS / tooling / build junk
.git/
.github/
.claude/
**/__pycache__/
**/*.pyc
**/tests/
.venv*/
*.egg-info/
dist/
coverage/
.env
.DS_Store
