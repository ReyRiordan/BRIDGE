# BRIDGE environment template — copy to .env for local runs.
#
# In DEPLOYED environments none of the secrets below are set as env config: they
# live in SSM Parameter Store and are resolved at cold start via
# SECRETS_FROM_SSM / SECRETS_SSM_PREFIXES (see runtime/voice_kit/config.py and
# docs/backend/voice-kit/02-configuration.md). NEVER set AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY on a deployed runtime — they shadow the task role
# (docs/backend/voice-kit/05-gotchas.md #1).

# =============================================================================
# BRIDGE runtime (runtime/) + control plane (api/)
# =============================================================================

ENV=development

# --- Provider API keys (consumer: runtime) -----------------------------------
OPENROUTER_API_KEY=                         # LLM + referee via OpenRouter
TOGETHER_API_KEY=                           # Parakeet STT via Together AI
INWORLD_API_KEY=                            # Inworld TTS (streaming audio)

# --- LLM (consumer: runtime) -------------------------------------------------
LLM_PROVIDER=openrouter                     # openrouter | bedrock
LLM_MODEL=anthropic/claude-haiku-4.5        # bedrock ex: openai.gpt-oss-120b
LLM_REASONING=none                          # none|minimal|low|medium|high|xhigh|max
# OpenRouter uses OPENROUTER_API_KEY above.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#LLM_PROVIDERS=groq,cerebras/fp16           # OpenRouter routing prefs; ignored on bedrock
# Bedrock only (keyless SigV4 via execution role):
#AWS_BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
#AWS_BEDROCK_SIGV4_SERVICE=bedrock-mantle

# --- STT (consumer: runtime) -------------------------------------------------
STT_PROVIDER=transcribe                     # transcribe | together (together sends audio off-AWS — dev only)
STT_PREROLL_MS=300

# --- VAD (consumer: runtime) -------------------------------------------------
# Defaults match pipecat's own; every knob is env-tunable without an image rebuild.
VAD_CONFIDENCE=0.7                          # Silero speech-probability threshold
VAD_START_SECS=0.2                          # speech needed before a turn starts
VAD_STOP_SECS=0.2                           # silence needed before a turn ends
VAD_MIN_VOLUME=0.6                          # minimum frame volume counted as speech
VAD_SPEECH_ACTIVITY_PERIOD=0.2              # spacing of speech-activity notifications
VAD_AUDIO_IDLE_TIMEOUT=1.0                  # force-stop the turn after this much audio silence (0 disables)
# Together uses TOGETHER_API_KEY above.

# --- TTS (consumer: runtime) -------------------------------------------------
TTS_PROVIDER=polly                          # polly | inworld
TTS_VOICE=Ruth                              # Polly voice, or Inworld voice (e.g. Ashley)
#TTS_MODEL=inworld-tts-1.5-mini             # Inworld only
# Inworld uses INWORLD_API_KEY above.

# --- AWS (consumer: both) ----------------------------------------------------
AWS_REGION=us-east-1
# LOCAL DEV ONLY — leave unset in any deployed environment:
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- Local dev mode (consumer: both) -----------------------------------------
# BRIDGE_LOCAL=1 runs the whole stack on localhost with zero AWS calls: it skips
# the KVS ICE fetch and the relay-only SDP filter, and implies VOICE_INVOKER=local.
# It REFUSES to start under ENV=production or with any AWS-backed provider, so the
# three non-AWS providers below are mandatory in local mode.
# See docs/backend/local-dev.md.
#BRIDGE_LOCAL=1
#STT_PROVIDER=together
#TTS_PROVIDER=inworld
#LLM_PROVIDER=openrouter
#REFEREE_PROVIDER=openrouter
#VOICE_RUNTIME_URL=http://localhost:8080     # LocalInvoker target ({url}/invocations)

# --- WebRTC / AgentCore wiring -----------------------------------------------
# Set by infra on both the runtime and the API host:
KVS_CHANNEL_NAME=
# Set by infra on the API host only (invoke_agent_runtime target):
VOICE_RUNTIME_ARN=
#RUNTIME_SESSION_ID_PREFIX=voicekit-        # prefix + 32 hex must be 33-256 chars

# --- Session (consumer: runtime) ---------------------------------------------
SESSION_TIME_LIMIT_MINUTES=30               # app conversation cap (informational to the kit); keep the frontend timer aligned
IDLE_TIMEOUT_SECS=180                       # pipeline self-termination after this much speech-free time

# --- Game engine (consumer: runtime) -----------------------------------------
# The referee scores each student turn for de-escalation actions.
# Effort: none|low|medium|high.
#REFEREE_PROVIDER=openrouter                # openrouter | bedrock
REFEREE_MODEL=anthropic/claude-haiku-4.5
REFEREE_EFFORT=none
REFEREE_TIMEOUT_SECONDS=7                   # referee fails open past this — it is on every turn's critical path
GAME_GRACE_SECONDS=45                       # after game_over, before the pipeline is torn down
# Scenario config (actions, point values, time limit) + the referee prompt. The
# deployed values are the container's copies; Dockerfile.voice COPYs resources/
# to /app/resources. Unset locally, both fall back to the repo's own files.
# LEFT COMMENTED DELIBERATELY: the /app paths do not exist on your machine, so
# setting them locally crashes the runtime. Infra sets them on the container.
#SCENARIO_PATH=/app/resources/scenario_1.json
#REFEREE_PROMPT_PATH=/app/resources/referee.txt

# --- Default context provider (runtime) --------------------------------------
# Unused by BRIDGE: bridge.app registers its own context provider (the patient
# agent's prompt comes from the game engine, not from these vars).
#SYSTEM_PROMPT=You are a friendly voice assistant.
#SYSTEM_PROMPT_PATH=/app/resources/patient.txt

# --- Deployed secrets mechanism (set by infra, not by hand) ------------------
#SECRETS_FROM_SSM=OPENROUTER_API_KEY,INWORLD_API_KEY,TOGETHER_API_KEY
#SECRETS_SSM_PREFIXES=/bridge/prod,/bridge/shared
